# logrotate config for the Remote Falcon listener log.
# Installed (copied) by scripts/postStart.sh to /etc/logrotate.d/remote-falcon
# on every plugin start, removed by fpp_uninstall.sh.
#
# Without rotation, multi-month show seasons accumulate gigabytes of log
# data on the SD card — the leading cause of FPP failures during the
# season. Daily rotation keeps the active file small and bounded.

/home/fpp/media/logs/plugin-remote-falcon.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su fpp fpp
    create 0664 fpp fpp
}
